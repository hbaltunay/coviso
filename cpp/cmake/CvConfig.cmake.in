@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(CV_BUILD_SHARED "@BUILD_SHARED_LIBS@")
if(NOT CV_BUILD_SHARED)
  find_dependency(nlohmann_json)
  find_dependency(OpenCV)
  find_dependency(spdlog)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CvTargets.cmake")

set(CV_AVAILABLE_MODULES "@CV_MODULES_ENABLED@")
foreach(comp IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
  if(comp IN_LIST CV_AVAILABLE_MODULES)
    set(${CMAKE_FIND_PACKAGE_NAME}_${comp}_FOUND TRUE)
  else()
    set(${CMAKE_FIND_PACKAGE_NAME}_${comp}_FOUND FALSE)
  endif()
endforeach()

check_required_components(${CMAKE_FIND_PACKAGE_NAME})