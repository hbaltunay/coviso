function(cv_resolve_modules out_var)
  set(all ${CV_MODULES_DISCOVERED})
  if(NOT all)
    message(FATAL_ERROR "No modules found (check under cpp/modules)")
  endif()

  # Validate that all dependencies for discovered modules are present.
  foreach(m IN LISTS all)
    foreach(d IN LISTS CV_MODULE_${m}_DEPS)
      if(NOT d IN_LIST all)
        message(FATAL_ERROR "Module '${m}' depends on a non-existent module '${d}'")
      endif()
    endforeach()
  endforeach()

  # Create a list of requested modules. If none are specified, build all modules.
  set(requested ${CV_BUILD_LIST})
  if(requested)
    set(selected "")
    set(queue ${requested})
    while(queue)
      list(POP_FRONT queue cur)
      if(cur IN_LIST selected)
        continue()
      endif()
      if(NOT cur IN_LIST all)
        message(FATAL_ERROR "Unknown module in CV_BUILD_LIST: '${cur}'")
      endif()
      list(APPEND selected ${cur})
      list(APPEND queue ${CV_MODULE_${cur}_DEPS})
    endwhile()
  else()
    set(selected ${all})
  endif()

  # Check for OPTIONAL_EXTERNALS across selected modules. If not found, 
  # gracefully disable the module without raising an error.
  set(disabled "")
  foreach(m IN LISTS selected)
    foreach(e IN LISTS CV_MODULE_${m}_EXT_OPTIONAL)
      cv_external_available(${e} ok)
      if(NOT ok)
        list(APPEND disabled ${m})
        message(STATUS "CV: '${m}' disabled (no external dependency: ${e})")
        break()
      endif()
    endforeach()
  endforeach()

  # Check if dependencies of selected modules are disabled. If a dependency is 
  # disabled, disable the module itself.
  set(changed TRUE)
  while(changed)
    set(changed FALSE)
    foreach(m IN LISTS selected)
      if(m IN_LIST disabled)
        continue()
      endif()
      foreach(d IN LISTS CV_MODULE_${m}_DEPS)
        if(d IN_LIST disabled)
          list(APPEND disabled ${m})
          message(STATUS "CV: '${m}' disabled ('${d}', which it depends on, is disabled)")
          set(changed TRUE)
          break()
        endif()
      endforeach()
    endforeach()
  endwhile()

  # The build will be aborted if any requested module is disabled.
  foreach(r IN LISTS requested)
    if(r IN_LIST disabled)
      message(FATAL_ERROR
        "The module '${r}', requested via CV_BUILD_LIST, cannot be built
        (see the CV messages above for the reason).")
    endif()
  endforeach()

  # Check for REQUIRED_EXTERNALS across selected modules. If not found, 
  # the build is aborted.
  foreach(m IN LISTS selected)
    if(m IN_LIST disabled)
      continue()
    endif()
    foreach(e IN LISTS CV_MODULE_${m}_EXT_REQUIRED)
      cv_external_available(${e} ok)
      if(NOT ok)
        message(FATAL_ERROR
          "Module '${m}' could not find a required external dependency: '${e}'. "
          "Please install it or exclude the module from CV_BUILD_LIST.")
      endif()
    endforeach()
  endforeach()

  # Separate selected modules into enabled and disabled categories.
  set(enabled ${selected})
  if(disabled)
    list(REMOVE_ITEM enabled ${disabled})
  endif()
  if(NOT enabled)
    message(FATAL_ERROR "No modules left to compile")
  endif()
  set(CV_MODULES_DISABLED "${disabled}" CACHE INTERNAL "")

  # Check for circular dependencies.
  set(sorted "")
  set(remaining ${enabled})
  while(remaining)
    set(progress FALSE)
    foreach(m IN LISTS remaining)
      set(ready TRUE)
      foreach(d IN LISTS CV_MODULE_${m}_DEPS)
        if(NOT d IN_LIST sorted)
          set(ready FALSE)
        endif()
      endforeach()
      if(ready)
        list(APPEND sorted ${m})
        list(REMOVE_ITEM remaining ${m})
        set(progress TRUE)
      endif()
    endforeach()
    if(NOT progress)
      message(FATAL_ERROR "Circular dependency, modules involved: ${remaining}")
    endif()
  endwhile()

  set(${out_var} "${sorted}" PARENT_SCOPE)
endfunction()